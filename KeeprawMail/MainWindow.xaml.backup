<Window
    x:Class="KeeprawMail.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                <RowDefinition Height="*"/>    <!-- Spacer -->
                <RowDefinition Height="Auto"/> <!-- Bottom: Settings -->
            </Grid.RowDefinitions>

            <!-- Top: Account Switcher -->
            <StackPanel Grid.Row="0" Spacing="12" HorizontalAlignment="Center">
                <!-- Active Account Indicator -->
                <PersonPicture DisplayName="User" Initials="U" Width="32" Height="32"/>
                <!-- Other Accounts (Placeholder) -->
                <FontIcon Glyph="&#xE77B;" FontSize="20" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>

            <!-- Bottom: Actions -->
            <StackPanel Grid.Row="2" Spacing="16" HorizontalAlignment="Center">
                <Button Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Add Account" Click="AddAccountButton_Click">
                    <FontIcon Glyph="&#xE710;" FontSize="16"/>
                </Button>
                <Button Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Settings" Click="SettingsButton_Click">
                    <FontIcon Glyph="&#xE713;" FontSize="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Row 0: Unified Toolbar -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Mail View Area -->
                <RowDefinition Height="*"/>
                <!-- Row 2: Status Bar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- C. Unified Toolbar -->
            <Grid Grid.Row="0" Padding="8,8,8,8" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Left Actions -->
                    <ColumnDefinition Width="*"/>    <!-- Spacer -->
                    <ColumnDefinition Width="Auto"/> <!-- Search -->
                </Grid.ColumnDefinitions>

                <CommandBar DefaultLabelPosition="Right" Background="Transparent" IsOpen="False" OverflowButtonVisibility="Auto">
                    <AppBarButton Label="New Mail">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Mail"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator/>
                    <AppBarButton Label="Sync" Command="{x:Bind ViewModel.RefreshCommand}">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Sync"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator/>
                    <AppBarButton Label="Delete" Command="{x:Bind ViewModel.DeleteCommand}">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Delete"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Forward">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Forward"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Reply">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE97A;"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>

                <!-- Search Box -->
                <AutoSuggestBox Grid.Column="2" 
                                Width="250" 
                                PlaceholderText="Search emails (Ctrl+E)" 
                                QueryIcon="Find"
                                Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <AutoSuggestBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Enter" />
                    </AutoSuggestBox.KeyboardAccelerators>
                </AutoSuggestBox>
            </Grid>

            <!-- Mail View Area (Split View) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- D. Mail List -->
                    <ColumnDefinition Width="350" MinWidth="250" MaxWidth="600"/>
                    <!-- Splitter -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- E. Reading Pane -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Mail List -->
                <ListView Grid.Column="0" 
                          ItemsSource="{Binding Emails}" 
                          SelectedItem="{Binding SelectedEmail, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:EmailMessage">
                            <Grid Padding="0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Subject -->
                                    <RowDefinition Height="Auto"/> <!-- Sender -->
                                    <RowDefinition Height="Auto"/> <!-- Snippet -->
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/> <!-- Date -->
                                </Grid.ColumnDefinitions>

                                <!-- Row 0: Subject -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Bind Subject}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind DateShortTime}" FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="8,0,0,0"/>

                                <!-- Row 1: Sender -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Bind SenderName}" FontSize="13" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextTrimming="CharacterEllipsis"/>

                                <!-- Row 2: Snippet -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Bind Snippet}" FontSize="12" Foreground="Gray" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Grid Splitter (Visual only for MVP, functionality needs WinUI Community Toolkit or custom implementation) -->
                <!-- Using a simple border for now as standard GridSplitter is not in core WinUI 3 yet, usually in CommunityToolkit -->
                <Border Grid.Column="1" Width="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}"/>

                <!-- E. Reading Pane -->
                <Grid Grid.Column="2" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <!-- Placeholder when no email selected -->
                    <TextBlock Text="Select an email to read" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               Visibility="{Binding SelectedEmail, Converter={StaticResource NullToVisibleConverter}, FallbackValue=Visible}"/>
                    
                    <!-- WebView2 -->
                    <!-- Note: Visibility binding requires a converter. For MVP we might just show it always or handle in code behind -->
                    <WebView2 x:Name="MessageWebView" />
                </Grid>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="2" 
                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" 
                    BorderThickness="0,1,0,0" 
                    Padding="12,6">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                           FontSize="12" 
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
