<Page
    x:Class="KeeprawMail.Views.ComposePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KeeprawMail.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="12">
            <TextBlock Text="写邮件" Style="{StaticResource TitleTextBlockStyle}"/>
            
            <TextBox x:Name="ToTextBox" Header="收件人" PlaceholderText="example@email.com"/>
            <TextBox x:Name="SubjectTextBox" Header="主题" PlaceholderText="邮件主题"/>
        </StackPanel>

        <!-- Body -->
        <TextBox x:Name="BodyTextBox" 
                 Grid.Row="1" 
                 Margin="0,12,0,12"
                 AcceptsReturn="True" 
                 TextWrapping="Wrap" 
                 PlaceholderText="在此输入邮件内容..."
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="取消" Click="CancelButton_Click"/>
            <Button x:Name="SendButton" Content="发送" Style="{StaticResource AccentButtonStyle}" Click="SendButton_Click"/>
        </StackPanel>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed">
            <ProgressRing IsActive="True" Width="64" Height="64"/>
        </Grid>
    </Grid>
</Page>
