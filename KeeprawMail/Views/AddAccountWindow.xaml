<Window
    x:Class="KeeprawMail.Views.AddAccountWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KeeprawMail.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="添加邮箱账号">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" 
                   Text="添加邮箱账号" 
                   FontSize="24" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,24"/>

        <!-- 表单区域 -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <!-- 服务商选择 -->
                <TextBlock Text="邮箱服务商" FontWeight="SemiBold"/>
                <ComboBox x:Name="ProviderComboBox" 
                          HorizontalAlignment="Stretch"
                          SelectionChanged="ProviderComboBox_SelectionChanged">
                    <ComboBoxItem Content="Gmail" Tag="Gmail"/>
                    <ComboBoxItem Content="Outlook / Hotmail" Tag="Outlook"/>
                    <ComboBoxItem Content="QQ 邮箱" Tag="QQ"/>
                    <ComboBoxItem Content="163 邮箱" Tag="Netease163"/>
                    <ComboBoxItem Content="126 邮箱" Tag="Netease126"/>
                    <ComboBoxItem Content="iCloud" Tag="iCloud"/>
                    <ComboBoxItem Content="Yahoo" Tag="Yahoo"/>
                    <ComboBoxItem Content="Yandex" Tag="Yandex"/>
                    <ComboBoxItem Content="新浪邮箱" Tag="Sina"/>
                    <ComboBoxItem Content="自定义" Tag="Custom" IsSelected="True"/>
                </ComboBox>

                <!-- 邮箱地址 -->
                <TextBlock Text="邮箱地址" FontWeight="SemiBold"/>
                <TextBox x:Name="EmailTextBox" 
                         PlaceholderText="example@gmail.com"
                         TextChanged="EmailTextBox_TextChanged"/>

                <!-- 密码/授权码 -->
                <TextBlock Text="密码或授权码" FontWeight="SemiBold"/>
                <PasswordBox x:Name="PasswordBox" 
                             PlaceholderText="请输入密码或授权码"/>
                
                <InfoBar x:Name="PasswordHintInfoBar"
                         IsOpen="False"
                         Severity="Informational"
                         Title="提示"
                         Message="QQ 邮箱和网易邮箱需要使用授权码，而非登录密码。请前往邮箱网页端设置中生成授权码。"/>

                <!-- OAuth 登录按钮 (仅 Gmail/Outlook) -->
                <Button x:Name="OAuthLoginButton"
                        Content="Sign in with Google"
                        HorizontalAlignment="Stretch"
                        Click="OAuthLoginButton_Click"
                        Visibility="Collapsed"
                        Background="White"
                        BorderBrush="#DADCE0"
                        Foreground="#3C4043"
                        Height="40">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <!-- Google Icon SVG -->
                                <Path Data="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" Fill="#4285F4"/>
                                <Path Data="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" Fill="#34A853"/>
                                <Path Data="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" Fill="#FBBC05"/>
                                <Path Data="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" Fill="#EA4335"/>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>

                <!-- IMAP 设置 -->
                <TextBlock Text="IMAP 服务器" FontWeight="SemiBold" Margin="0,12,0,0"/>
                <TextBox x:Name="ImapServerTextBox" PlaceholderText="imap.example.com"/>
                
                <TextBlock Text="IMAP 端口" FontWeight="SemiBold"/>
                <NumberBox x:Name="ImapPortNumberBox" 
                           Value="993" 
                           Minimum="1" 
                           Maximum="65535"
                           SpinButtonPlacementMode="Inline"/>

                <!-- SMTP 设置 -->
                <TextBlock Text="SMTP 服务器" FontWeight="SemiBold" Margin="0,12,0,0"/>
                <TextBox x:Name="SmtpServerTextBox" PlaceholderText="smtp.example.com"/>
                
                <TextBlock Text="SMTP 端口" FontWeight="SemiBold"/>
                <NumberBox x:Name="SmtpPortNumberBox" 
                           Value="465" 
                           Minimum="1" 
                           Maximum="65535"
                           SpinButtonPlacementMode="Inline"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Spacing="12" 
                    Margin="0,24,0,0">
            <Button Content="取消" 
                    Click="CancelButton_Click" 
                    MinWidth="100"/>
            <Button Content="保存" 
                    Click="SaveButton_Click" 
                    Style="{StaticResource AccentButtonStyle}" 
                    MinWidth="100"/>
        </StackPanel>
    </Grid>
</Window>
